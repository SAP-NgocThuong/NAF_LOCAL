@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName:       'Template Word',
                typeNamePlural: 'Template Word (thử)',
                title:       { type: #STANDARD, value: 'TmplId' },
                description: { type: #STANDARD, value: 'Description' } }
}
annotate view ZC_WORD_TMPL_TEST with
{
  @UI.facet: [ { id: 'general', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Thông tin', position: 10 } ]

  @UI.hidden: true
  TmplUuid;

  @UI.lineItem:       [ { position: 10, label: 'Mã template' } ]
  @UI.identification: [ { position: 10, label: 'Mã template' } ]
  @UI.selectionField: [ { position: 10 } ]
  TmplId;

  @UI.lineItem:       [ { position: 20, label: 'Mô tả' } ]
  @UI.identification: [ { position: 20, label: 'Mô tả' } ]
  Description;

  @UI.lineItem:       [ { position: 30, label: 'Template (.docx)' } ]
  @UI.identification: [ { position: 30, label: 'Template (.docx)' } ]
  TmplContent;

  @UI.hidden: true
  TmplMime;

  @UI.hidden: true
  TmplName;

  @UI.lineItem:       [ { position: 40, label: 'Người tạo' } ]
  CreatedBy;

  @UI.lineItem:       [ { position: 50, label: 'Ngày tạo' } ]
  CreatedAt;
}
