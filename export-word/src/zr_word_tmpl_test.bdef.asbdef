managed implementation in class zbp_r_word_tmpl_test unique;
strict ( 2 );
with draft;

define behavior for ZR_WORD_TMPL_TEST alias Template
persistent table ztb_wdtpl_test
draft table ztb_wdtpl_test_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) TmplUuid;
  field ( mandatory ) TmplId;
  field ( readonly ) CreatedBy, CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  validation checkTemplate on save { create; field TmplContent; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare { validation checkTemplate; }

  mapping for ztb_wdtpl_test
    {
      TmplUuid           = tmpl_uuid;
      TmplId             = tmpl_id;
      Description        = description;
      TmplContent        = tmpl_content;
      TmplName           = tmpl_name;
      TmplMime           = tmpl_mime;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }
}
